<?xml version="1.0" encoding="utf-8"?>
<!--
    Item do RecyclerView — card de Pokémon.
    Exibe: imagem (via Glide), nome e badge de tipo.
    Conforme estrutura da atividade PDM: nome, tipo, descricao, imagem.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Círculo cinza de fundo + sprite do Pokémon -->
        <FrameLayout
            android:layout_width="86dp"
            android:layout_height="86dp"
            android:layout_gravity="center_vertical">

            <View
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_sprite_circle" />

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="86dp"
                android:layout_height="86dp"
                android:layout_gravity="center"
                android:contentDescription="Sprite do Pokémon"
                android:padding="4dp"
                android:scaleType="fitCenter"
                tools:src="@mipmap/ic_launcher" />
        </FrameLayout>

        <!-- Informações: nome + badge de tipo -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Nome do Pokémon -->
            <TextView
                android:id="@+id/txtNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Bulbasaur" />

            <!-- Badge do tipo (cor dinâmica via adapter) -->
            <TextView
                android:id="@+id/txtTipo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_type_badge"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Planta" />

        </LinearLayout>

        <!-- Seta indicadora -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingEnd="4dp"
            android:text="›"
            android:textColor="@color/number_text"
            android:textSize="28sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
