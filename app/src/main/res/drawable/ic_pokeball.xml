<?xml version="1.0" encoding="utf-8"?>
<!-- Pokéball vector icon for splash screen -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Top half - red -->
    <path
        android:fillColor="#CC0000"
        android:pathData="M 100,10
                          A 90,90 0 0,1 190,100
                          L 110,100
                          A 10,10 0 0,0 90,100
                          L 10,100
                          A 90,90 0 0,1 100,10 Z" />

    <!-- Bottom half - white -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 100,190
                          A 90,90 0 0,1 10,100
                          L 90,100
                          A 10,10 0 0,0 110,100
                          L 190,100
                          A 90,90 0 0,1 100,190 Z" />

    <!-- Center band - black -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M 10,95 L 190,95 L 190,105 L 10,105 Z" />

    <!-- Center circle white -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 100,100 m -18,0 a 18,18 0 1,0 36,0 a 18,18 0 1,0 -36,0" />

    <!-- Center circle black ring -->
    <path
        android:fillColor="#1A1A1A"
        android:pathData="M 100,100 m -14,0 a 14,14 0 1,0 28,0 a 14,14 0 1,0 -28,0
                          M 100,100 m -10,0 a 10,10 0 1,1 20,0 a 10,10 0 1,1 -20,0" />

    <!-- Center button -->
    <path
        android:fillColor="#F5F5F5"
        android:pathData="M 100,100 m -8,0 a 8,8 0 1,0 16,0 a 8,8 0 1,0 -16,0" />

    <!-- Outer border -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1A1A1A"
        android:strokeWidth="5"
        android:pathData="M 100,10 A 90,90 0 0,1 190,100 A 90,90 0 0,1 10,100 A 90,90 0 0,1 100,10 Z" />
</vector>
